---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Adil Zhantaev"
  description="Personal website of Adil Zhantaev, frontend developer."
>
  <section class="py-12">
    <h1 class="mb-4 text-[clamp(2rem,6vw,3rem)] leading-tight font-bold">
      Hi, I'm Adil Zhantaev.
    </h1>
    <p class="mb-6 text-xl text-muted">
      Frontend developer building fast, accessible, and content-driven web experiences.
    </p>
    <a
      class="inline-block rounded-md bg-accent px-5 py-2.5 font-semibold text-white no-underline"
      href={`${base}/projects/`}>See my projects</a
    >
  </section>
</BaseLayout>
