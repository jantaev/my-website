---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}

const { title, href, linkLabel = "View project" } = Astro.props;
---

<article class="rounded-lg border border-border p-4">
  <h2 class="mt-0 text-xl font-semibold">{title}</h2>
  <div class="my-2 text-text"><slot /></div>
  {
    href ? (
      <a class="text-accent" href={href}>
        {linkLabel}
      </a>
    ) : (
      <p class="text-muted">Link: coming soon</p>
    )
  }
</article>
